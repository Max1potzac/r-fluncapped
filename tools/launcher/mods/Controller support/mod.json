{
  "id": "controller",
  "name": "Controller support",
  "description": "Xbox, PlayStation and Switch controllers play the lawn like PvZ1's console version: a cursor box, LB/RB for seeds, A to plant.",
  "author": "r-fluncapped",
  "version": "1.0",
  "kind": "injection",
  "category": "Controls",
  "games": ["global"],
  "default": true,
  "rfu": ["--controller"],
  // the launcher adds the buttons moved in Controller settings, games\controllers.txt and the
  // game's controller-layout.txt (buttons placed in the keybind layout editor)
  "hooks": ["pad-binds"],
  "actions": [{ "label": "Controller settings", "run": "controller-settings" }]
}
